<Window x:Class="AZRemoteConnect.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AZ RemoteConnect — LAN Preview" Height="670" Width="1040" MinHeight="500" MinWidth="760" Background="#091B36"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="315"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,18,0"><TextBlock Text="AZ RemoteConnect" Foreground="White" FontWeight="Bold" FontSize="25"/><TextBlock Text="Secure blue remote desktop" Foreground="#91A2BE" Margin="0,3,0,18"/><TextBlock Text="HOST THIS COMPUTER" Foreground="White" FontWeight="Bold"/><Button x:Name="StartHost" Content="Start hosting" Click="StartHost_Click" Margin="0,8,0,10" Height="38"/><TextBlock x:Name="HostDetails" Foreground="#E0E7F2" TextWrapping="Wrap" Margin="0,0,0,20"/><TextBlock Text="CONNECT TO COMPUTER" Foreground="White" FontWeight="Bold"/><TextBlock Text="Host IP / DNS" Foreground="#AEC0D6" Margin="0,10,0,3"/><TextBox x:Name="RemoteHost" Text="127.0.0.1" Height="30"/><TextBlock Text="Port" Foreground="#AEC0D6" Margin="0,8,0,3"/><TextBox x:Name="RemotePort" Text="48765" Height="30"/><TextBlock Text="6-digit pairing code" Foreground="#AEC0D6" Margin="0,8,0,3"/><TextBox x:Name="RemoteCode" Height="30"/><TextBlock Text="6-character verification code (or full fingerprint)" Foreground="#AEC0D6" Margin="0,8,0,3"/><TextBox x:Name="RemoteFingerprint" Height="30"/><Button x:Name="Connect" Content="Connect" Click="Connect_Click" Height="38" Margin="0,12,0,8"/><Button Content="Disconnect / Stop" Click="Stop_Click" Height="32"/><TextBlock x:Name="Status" Text="Not connected" Foreground="#AEC0D6" TextWrapping="Wrap" Margin="0,20,0,0"/><TextBlock Text="For trusted LANs only. Both sides must exchange code and verification securely. The host must approve the session." Foreground="#91A2BE" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel><Border Grid.Column="1" BorderBrush="#2879C8" BorderThickness="1" Background="#071323"><Grid><Image x:Name="ScreenView" Stretch="Uniform" MouseMove="ScreenView_MouseMove" MouseDown="ScreenView_MouseDown" MouseUp="ScreenView_MouseUp"/><TextBlock x:Name="EmptyScreen" Text="Remote screen will appear here" Foreground="#9CAAC0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid></Window>